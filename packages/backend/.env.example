# Copy this file to .env and fill in real values before running the backend.

# Postgres connection (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://cursor:cursor_local_pw@localhost:5433/cursor_credit?schema=public"

# Server
PORT=4000

# Brevo (Sendinblue) transactional email
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=events@cafecursor.com
BREVO_SENDER_NAME=Cafe Cursor

# Voucher email content
# Dollar amount shown in the email (e.g. "$50 in Cursor credits")
CREDIT_AMOUNT_USD=50
# Optional: a publicly-hosted URL to the Cursor logo image to show at the top of the email.
# Leave blank to show a plain text heading instead.
EMAIL_LOGO_URL=https://cdn.prod.website-files.com/66d7fce027e564db2ca93b06/6743094de405ccdd2bd06625_Cusor-Logo.svg
